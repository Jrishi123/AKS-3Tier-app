{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "frontend",
    "api",
    "postgres",
    "ingress",
    "tls",
    "migration"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": ["domain", "keyVault"],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "keyVault": {
          "type": "object",
          "required": ["name", "tenantId", "clientId"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "tenantId": {"type": "string", "minLength": 1},
            "clientId": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "image", "replicaCount", "service", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "api": {
      "type": "object",
      "required": ["enabled", "image", "replicaCount", "service", "serviceAccount", "resources", "env"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name", "clientId"],
          "properties": {
            "create": {"type": "boolean"},
            "name": {"type": "string", "minLength": 1},
            "clientId": {"type": "string", "minLength": 1}
          }
        },
        "resources": {"$ref": "#/definitions/resources"},
        "env": {
          "type": "object",
          "required": ["DB_HOST", "DB_PORT", "DB_NAME", "DB_USER"],
          "properties": {
            "DB_HOST": {"type": "string", "minLength": 1},
            "DB_PORT": {"type": "string", "pattern": "^[0-9]+$"},
            "DB_NAME": {"type": "string", "minLength": 1},
            "DB_USER": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["enabled", "image", "service", "storage", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "storage": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"}
          }
        },
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "minLength": 1},
        "annotations": {"type": "object"}
      }
    },
    "tls": {
      "type": "object",
      "required": ["enabled", "secretName", "clusterIssuer"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secretName": {"type": "string", "minLength": 1},
        "clusterIssuer": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object",
      "required": ["enabled", "image", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1}
          }
        },
        "resources": {"$ref": "#/definitions/resources"}
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourceValues"},
        "limits": {"$ref": "#/definitions/resourceValues"}
      }
    },
    "resourceValues": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "minLength": 1}
      }
    }
  }
}
